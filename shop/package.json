{
  "name": "aistudio365-shop",
  "version": "0.1.0",
  "private": true,
  "description": "AIStudio365 shop: pick a product, pay with a personal QR code, contact customer service.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "typecheck:web": "vue-tsc -p web/tsconfig.json",
    "check": "npm run typecheck && npm run typecheck:web && npm test",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "import:dujiao": "tsx scripts/import-dujiao.ts",
    "products:list": "tsx scripts/list-products.ts",
    "admin:password": "tsx server/src/cli/admin-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.7",
    "@fastify/static": "^10.1.9",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.17",
    "fastify": "^5.12.8",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
